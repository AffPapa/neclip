{
  "schemaVersion": 1,
  "product": {
    "name": "NeClip",
    "summary": "Local clipboard history, snippets and safe EN/RU layout correction for macOS",
    "license": "MIT",
    "accountRequired": false,
    "cloudSync": false,
    "telemetry": false,
    "distribution": "GitHub Releases"
  },
  "platform": {
    "minimumMacOS": "14.0",
    "architectures": ["arm64"],
    "interface": "menu-bar-only",
    "dockIcon": false
  },
  "canonical": {
    "repository": "https://github.com/AffPapa/neclip",
    "website": "https://affpapa.github.io/neclip/",
    "latestVersion": "https://affpapa.github.io/neclip/version.json",
    "changelogFeed": "https://affpapa.github.io/neclip/changelog.json",
    "releaseFeed": "https://github.com/AffPapa/neclip/releases.atom",
    "changelog": "https://github.com/AffPapa/neclip/blob/main/CHANGELOG.md",
    "backlog": "https://github.com/AffPapa/neclip/blob/main/BACKLOG.md",
    "engineeringAudit": "https://github.com/AffPapa/neclip/blob/main/docs/AUDIT-2026-09-01.md",
    "projectMap": "https://github.com/AffPapa/neclip/blob/main/docs/PROJECT-MAP.md",
    "competitorResearch": "https://github.com/AffPapa/neclip/blob/main/docs/COMPETITOR-UX-2026-09-01.md",
    "security": "https://github.com/AffPapa/neclip/blob/main/SECURITY.md",
    "license": "https://github.com/AffPapa/neclip/blob/main/LICENSE"
  },
  "features": [
    "clipboard history for text, images and files",
    "local search, pins, individual delete with undo and OCR",
    "discoverable editable snippet folders, starter snippets and local placeholders",
    "manual EN/RU layout correction with a configurable shortcut",
    "optional conservative automatic EN/RU correction",
    "off-only automatic-correction safety shortcut",
    "direct recent-history sequential paste",
    "five configurable conflict-safe global shortcuts",
    "sectioned local settings",
    "configurable grapheme-safe menu label length",
    "discoverable native structured-search filters",
    "bounded menu browsing with complete on-demand search",
    "atomic local history and snippet erasure",
    "bounded local storage and privacy exclusions"
  ],
  "shortcuts": [
    {"action": "open-history", "keys": "Command-Shift-V", "customizable": true},
    {"action": "open-snippets", "keys": "Command-Shift-B", "customizable": true},
    {"action": "sequential-paste", "keys": "Control-Command-V", "customizable": true},
    {"action": "correct-layout", "keys": "Option-Shift-L", "customizable": true},
    {"action": "disable-automatic-layout-correction", "keys": "Control-Option-A", "customizable": true, "offOnly": true},
    {"action": "pin-first-result", "keys": "Command-P"},
    {"action": "save-first-result-as-snippet", "keys": "Command-S"},
    {"action": "delete-first-result", "keys": "Command-Delete"},
    {"action": "undo-item-deletion", "keys": "Command-Z"},
    {"action": "paste-plain-text", "keys": "Shift-Return"},
    {"action": "copy-without-pasting", "keys": "Command-Return"}
  ],
  "permissions": {
    "pasteboard": "Explained before monitoring; denied access fails closed on macOS 15.4+",
    "accessibility": "Optional; used for one-click paste and manual selected-text replacement",
    "inputMonitoring": "Requested only when automatic layout correction is explicitly enabled"
  },
  "notPlanned": [
    "accounts",
    "cloud synchronization",
    "telemetry or advertising",
    "AI processing of clipboard contents",
    "a permanent Dock icon"
  ]
}
